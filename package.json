{
  "name": "game-account-select",
  "version": "0.1.0",
  "private": true,
  "description": "One agent skill for screening game accounts on trading sites, with experience organised by site and game.",
  "type": "module",
  "scripts": {
    "list:skills": "node scripts/list-skills.js",
    "link:skills": "node scripts/link-local-skills.js",
    "unlink:skills": "node scripts/unlink-local-skills.js",
    "profile": "node skills/game-account-select/scripts/profile.mjs",
    "preflight": "node skills/game-account-select/scripts/preflight.mjs",
    "query": "node skills/game-account-select/scripts/query.mjs",
    "query:cleanup": "node skills/game-account-select/scripts/cleanup.mjs",
    "shortlist": "node skills/game-account-select/scripts/shortlist.mjs",
    "pzds:health": "node skills/game-account-select/scripts/query.mjs --operation pzds/arknights-list --limit 1 --task-space gas-pzds-health --json",
    "verify:frontmatter": "node scripts/verify-skill-frontmatter.js",
    "verify:query-stack": "node skills/game-account-select/tests/validate-query-stack.mjs",
    "verify:ego-operations": "node skills/game-account-select/tests/validate-ego-operations.mjs && node skills/game-account-select/tests/validate-zzz-pxb7-detail-parser.mjs && node skills/game-account-select/tests/validate-browser-cleanup.mjs",
    "verify:harness": "node scripts/verify-harness.mjs && node --test scripts/tests/*.test.mjs",
    "verify:skills": "npm run verify:harness && npm run verify:frontmatter && npm run verify:query-stack && npm run verify:ego-operations && node --test skills/game-account-select/tests/*.test.mjs",
    "dev:context": "node scripts/dev.mjs context",
    "dev:plan": "node scripts/dev.mjs plan",
    "dev:check": "node scripts/dev.mjs check"
  },
  "keywords": [
    "agent-skills",
    "codex",
    "game-account",
    "valuation"
  ],
  "license": "MIT"
}
